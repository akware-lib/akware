function pages:openpage()
    local page=self
    if not page.open then
        for _,v in pairs(page.library.pages) do
            if v~=page and v.open then v.page.Visible=false; v.open=false; v.outline.BackgroundColor3=Color3.fromRGB(24,24,24); v.line.Size=UDim2.new(1,0,0,2); v.line.BackgroundColor3=Color3.fromRGB(24,24,24) end
        end
        page.page.Visible=true; page.open=true; page.outline.BackgroundColor3=Color3.fromRGB(20,20,20); page.line.Size=UDim2.new(1,0,0,3); page.line.BackgroundColor3=Color3.fromRGB(20,20,20)
    end
end

