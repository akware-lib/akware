        utility.makeGradient(self.color,self.library.theme.gradientA or self.library.theme.accent,self.library.theme.gradientB or self.library.theme.accent)
        table.insert(self.library.gradientFrames,self.color); table.insert(self.library.themeitems["accent"]["BackgroundColor3"],self.color)
