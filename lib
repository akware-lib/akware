    local colorBar=utility.new("Frame",{AnchorPoint=Vector2.new(0.5,0),BackgroundColor3=self.library.theme.accent,BorderSizePixel=0,Size=UDim2.new(1,-2,0,1),Position=UDim2.new(0.5,0,0,0),Parent=outline})
    utility.makeGradient(colorBar,self.library.theme.gradientA or self.library.theme.accent,self.library.theme.gradientB or self.library.theme.accent)
