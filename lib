    local sectionholder=utility.new("Frame",{BackgroundColor3=Color3.fromRGB(24,24,24),BorderColor3=Color3.fromRGB(56,56,56),BorderMode="Inset",BorderSizePixel=1,Size=UDim2.new(1,0,0,size),Parent=self[side]})
