function sections:slider(props)
    local name=props.name or "slider"; local def=math.clamp(props.def or 0,props.min or 0,props.max or 100)
    local max=props.max or 100; local min=props.min or 0; local rounding=props.rounding or false
    local ticking=props.tick or false; local measurement=props.measurement or ""; local callback=props.callback or function()end
    local sliderholder=utility.new("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,25),Parent=self.content})
    local outline=utility.new("Frame",{BackgroundColor3=Color3.fromRGB(24,24,24),BorderColor3=Color3.fromRGB(12,12,12),BorderMode="Inset",BorderSizePixel=1,Size=UDim2.new(1,0,0,12),Position=UDim2.new(0,0,0,15),Parent=sliderholder})
    local outline2=utility.new("Frame",{BackgroundColor3=Color3.fromRGB(30,30,30),BorderColor3=Color3.fromRGB(56,56,56),BorderMode="Inset",BorderSizePixel=1,Size=UDim2.new(1,0,1,0),Parent=outline})
    local value=utility.new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,2),Position=UDim2.new(0,0,0.5,0),Font=self.library.font,Text=def..measurement.."/"..max..measurement,TextColor3=Color3.fromRGB(255,255,255),TextSize=self.library.textsize,TextStrokeTransparency=0,ZIndex=3,Parent=outline})
    local color=utility.new("Frame",{BackgroundColor3=Color3.fromRGB(30,30,30),BorderSizePixel=0,Size=UDim2.new(1,0,1,0),Parent=outline2})
    utility.new("UIGradient",{Color=ColorSequence.new{ColorSequenceKeypoint.new(0,Color3.fromRGB(199,191,204)),ColorSequenceKeypoint.new(1,Color3.fromRGB(255,255,255))},Rotation=90,Parent=color})
    local pct=(max-min)>0 and (def-min)/(max-min) or 0
    local slide=utility.new("Frame",{BackgroundColor3=self.library.theme.accent,BorderSizePixel=0,Size=UDim2.new(pct,0,1,0),ZIndex=2,Parent=outline})
    utility.makeGradient(slide,self.library.theme.gradientA or self.library.theme.accent,self.library.theme.gradientB or self.library.theme.accent)
    table.insert(self.library.gradientFrames,slide); table.insert(self.library.themeitems["accent"]["BackgroundColor3"],slide)
    local sliderbutton=utility.new("TextButton",{AnchorPoint=Vector2.new(0,0),BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),Position=UDim2.new(0,0,0,0),Text="",Parent=sliderholder})
    local title=utility.new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,15),Position=UDim2.new(0,0,0,0),Font=self.library.font,Text=name,TextColor3=Color3.fromRGB(255,255,255),TextSize=self.library.textsize,TextStrokeTransparency=0,TextXAlignment="Left",Parent=sliderholder})
    local slider={library=self.library,outline=outline,sliderbutton=sliderbutton,title=title,value=value,slide=slide,color=color,max=max,min=min,current=def,measurement=measurement,tick=ticking,rounding=rounding,callback=callback}
    local function doSlide()
        local size=math.clamp(plr:GetMouse().X-slider.color.AbsolutePosition.X,0,slider.color.AbsoluteSize.X)
        local result=(slider.max-slider.min)/slider.color.AbsoluteSize.X*size+slider.min
        local newres=slider.rounding and math.floor(result) or utility.round(result,2)
        slider.value.Text=newres..slider.measurement.."/"..slider.max..slider.measurement; slider.current=newres; slider.callback(newres)
        local tp=slider.tick and (slider.color.AbsoluteSize.X/(slider.max-slider.min)*(newres-slider.min)) or size
        slider.slide:TweenSize(UDim2.new((1/slider.color.AbsoluteSize.X)*tp,0,1,0),Enum.EasingDirection.Out,Enum.EasingStyle.Quad,0.15,true)
    end
    sliderbutton.MouseButton1Down:Connect(function() slider.holding=true; doSlide(); outline.BorderColor3=self.library.theme.accent; table.insert(self.library.themeitems["accent"]["BorderColor3"],outline) end)
    uis.InputChanged:Connect(function() if slider.holding then doSlide() end end)
    uis.InputEnded:Connect(function(Input)
        if Input.UserInputType.Name=="MouseButton1" and slider.holding then
            slider.holding=false; outline.BorderColor3=Color3.fromRGB(12,12,12)
            local f=table.find(self.library.themeitems["accent"]["BorderColor3"],outline); if f then table.remove(self.library.themeitems["accent"]["BorderColor3"],f) end
        end
    end)
    local pointer=props.pointer or nil; if pointer and self.pointers then self.pointers[tostring(pointer)]=slider end
    self.library.labels[#self.library.labels+1]=title; self.library.labels[#self.library.labels+1]=value
    setmetatable(slider,sliders); return slider
end

function sliders:set(value)
    local size=math.clamp((self.color.AbsoluteSize.X/(self.max-self.min)*(value-self.min)),0,self.color.AbsoluteSize.X)
    local newres=self.rounding and math.floor(value) or utility.round(value,2)
    self.value.Text=newres..self.measurement.."/"..self.max..self.measurement; self.current=newres; self.callback(newres)
    local tp=self.tick and (self.color.AbsoluteSize.X/(self.max-self.min)*(newres-self.min)) or size
    self.slide:TweenSize(UDim2.new((1/self.color.AbsoluteSize.X)*tp,0,1,0),Enum.EasingDirection.Out,Enum.EasingStyle.Quad,0.15,true)
end

